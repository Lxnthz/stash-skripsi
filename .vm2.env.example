# =============================================================================
# .vm2.env.example  –  copy to .vm2.env and fill in secrets
# =============================================================================

# ── REQUIRED ──────────────────────────────────────────────────────────────────
VM2_AES_KEY_B64=

# ── GCP / service account ─────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/home/recovery/utilities/serviceaccount.json

# ── paths ─────────────────────────────────────────────────────────────────────
VM2_INCOMING_DIR=/home/recovery/local-backup/incoming
VM2_ENCRYPTED_ROOT=/home/recovery/local-backup/encrypted
VM2_RESTORE_REQUEST_DIR=/home/recovery/local-backup/restore-requests
VM2_OUTGOING_ROOT=/home/recovery/local-backup/outgoing/primary
VM2_STATE_DIR=/home/recovery/local-backup/state
VM2_LOG_FILE=/home/recovery/local-backup/state/vm2_service.log
VM2_WORK_DIR=

# ── behaviour ─────────────────────────────────────────────────────────────────
VM2_POLL_SECONDS=15
VM2_DELETE_INCOMING_ON_SUCCESS=1
VM2_VM1_DEST_ROOT_DEFAULT=primary@192.168.10.128:/home/primary/data/backup-incoming

# ── general (hot) cloud bucket upload ─────────────────────────────────────────
VM2_ENABLE_GENERAL_UPLOAD=1
VM2_UPLOAD_GENERAL_CMD="rclone copy {src} mygcs:YOUR-GENERAL-BUCKET/{chain_v}/"

# ── immutable cloud bucket upload ─────────────────────────────────────────────
VM2_ENABLE_IMMUTABLE_UPLOAD=0
VM2_UPLOAD_IMMUTABLE_CMD="rclone copy {src} mygcs:YOUR-IMMUTABLE-BUCKET/{chain_v}/"

# ── rclone remotes for cloud restore ──────────────────────────────────────────
VM2_RCLONE_GENERAL_REMOTE=mygcs:YOUR-GENERAL-BUCKET
VM2_RCLONE_IMMUTABLE_REMOTE=mygcs:YOUR-IMMUTABLE-BUCKET